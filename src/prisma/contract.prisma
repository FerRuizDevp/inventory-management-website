// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  createdAt temporal.createdAtString()
  updatedAt temporal.updatedAtString()
}

model Product {
  id         String @id @default(uuid())
  userId     String
  name       String
  sku        String? @unique
  price      Numeric(12,2)
  quantity   Int @default(0)
  lowStockAt Int?
  createdAt temporal.createdAtString()
  updatedAt temporal.updatedAtString()

  @@index([userId, name])
  @@index([createdAt])
}