// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Product {
  id         String @id @default(uuid())
  userId     String
  name       String
  sku        String? @unique
  price      Numeric(12,2)
  quantity   Int @default(0)
  lowStockAt Int?
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()

  @@index([userId, name])
  @@index([createdAt])
}